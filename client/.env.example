# ==============================================================================
# FLOWW / LEDGERX CLIENT — PRODUCTION ENVIRONMENT CONFIGURATION
# Copy this file to .env in client directory when building for production.
# ==============================================================================

# Production Backend API URL
# Leave empty or set to /api if hosting frontend and backend under the same Nginx proxy domain.
# Set to full HTTPS URL if frontend is hosted separately (e.g. Vercel, Netlify).
VITE_API_URL=https://api.ledgerx.yourdomain.com/api
