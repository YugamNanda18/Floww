# ==============================================================================
# FLOWW / LEDGERX — PRODUCTION ENVIRONMENT CONFIGURATION
# Copy this file to .env and fill in real production values.
# ==============================================================================

# --- Server Core & Port ---
PORT=5000
NODE_ENV=production

# --- Frontend Application URL (for CORS & Email links) ---
CLIENT_URL=https://ledgerx.yourdomain.com

# --- MongoDB Production Database Connection URI ---
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/ledgerx?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/ledgerx?retryWrites=true&w=majority
# (MONGODB_URI is also accepted as an alias)
MONGODB_URI=

# --- JWT Authentication Secrets (Generate 64+ char random strings) ---
# Command to generate: openssl rand -base64 48
JWT_SECRET=production_super_secret_jwt_key_at_least_64_characters_long_change_me
JWT_REFRESH_SECRET=production_super_secret_refresh_jwt_key_at_least_64_characters_long_change_me
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Tamper-Evident Receipt Hash Salt ---
RECEIPT_HASH_SALT=production_receipt_sha256_salt_change_me

# --- Razorpay Online Payment Gateway Credentials ---
# Get from Razorpay Dashboard -> Settings -> API Keys & Webhooks
RAZORPAY_KEY_ID=rzp_live_YOUR_KEY_ID_HERE
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_SECRET_HERE
RAZORPAY_WEBHOOK_SECRET=YOUR_RAZORPAY_WEBHOOK_SECRET_HERE

# --- SMTP Production Email Service (Gmail / SendGrid / AWS SES / Postmark) ---
# Example for Gmail SMTP:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=finance@yourcollege.edu.in
# SMTP_PASS=your_app_password_here
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=finance@yourdomain.com
SMTP_PASS=your_smtp_app_password

# --- Redis Background Queue (Optional: for automated late fee jobs & background reminders) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Gemini AI / DeepSeek Assistant Key (Optional: for AI Fee Assistant) ---
GEMINI_API_KEY=your_gemini_api_key_here
